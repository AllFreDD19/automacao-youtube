# Copie este arquivo para ".env" e preencha as chaves.

# IA de texto: Nemotron (https://build.nvidia.com -> Get API Key)
# Outras opções: nvidia/nemotron-3.5-lightning-30b-a3b (mais leve)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Pesquisa de nichos/referências: Google Cloud Console -> ative "YouTube Data API v3" -> Credenciais -> Chave de API
YOUTUBE_API_KEY=

# Imagens e vídeos de banco: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Vídeos de banco extras (opcional): https://www.pexels.com/api/
PEXELS_API_KEY=

# De onde vêm as imagens:
#   pixabay -> fotos do Pixabay; se não achar, gera com IA (NVIDIA FLUX ou Pollinations)
#   ia      -> cenas marcadas como "ia" no roteiro são geradas por IA
IMAGEM_PROVEDOR=pixabay

# Narração em inglês: Kokoro, local e grátis (padrão). VOZ_PROVEDOR=edge volta para o Edge TTS.
# Vozes do Kokoro: am_michael, am_fenrir, am_puck, bm_george, bm_fable, af_heart...
VOZ_PROVEDOR=kokoro
VOZ_KOKORO=am_michael
VOZ_KOKORO_VELOCIDADE=1.05
# Espanhol, alemão e francês: Piper local (modelos em vozes_piper/, baixados pelo instalar.bat).
# Outros idiomas: Edge TTS (grátis). Lista de vozes em português: python main.py vozes
VOZ=pt-BR-AntonioNeural
VOZ_VELOCIDADE=+5%

# Roteiro (padrões do Prompt Mestre em prompts/roteiro_mestre.md)
# 735 caracteres ≈ 1 minuto de narração: 11000 ≈ 15 min, 22000 ≈ 30 min
IDIOMA_ROTEIRO=português
CAPITULOS=4
CARACTERES=11000
META_CANAL=

# Vídeo
MUSICA_VOLUME=0.10
LEGENDAS=sim
# Apresentador de IA (rosto falando numa janela redonda na abertura e nos pedidos de inscrição)
APRESENTADOR=nao
REGIAO=BR
IDIOMA=pt

# Parte das cenas em video (o resto e imagem com zoom lento). 0.5 = metade
PROPORCAO_VIDEO=0.5


# Fotos profissionais do Unsplash (grátis): https://unsplash.com/developers -> New Application -> copie a 'Access Key'
UNSPLASH_ACCESS_KEY=

